@* SalesAnalysis.Web/Views/Import/Index.cshtml *@
@{
    ViewData["Title"] = "Імпорт Даних Продажів";
}

<!-- Tailwind -->
<script src="https://cdn.tailwindcss.com"></script>

<style>
    body {
        background-color: #f4f7f9;
        font-family: 'Inter', sans-serif;
    }
</style>
<!-- ======= HEADER / NAVBAR ======= -->

<div class="w-full flex justify-center mt-0 px-4">
    <div class="bg-white shadow-xl rounded-2xl p-10 max-w-2xl w-full">

        <!-- Заголовок -->
        <div class="flex items-center justify-center space-x-3 mb-4">
            <span class="text-4xl">📄</span>
            <h1 class="text-3xl font-extrabold text-gray-800">
                Завантаження Даних Транзакцій
            </h1>
        </div>

        <p class="text-gray-600 text-center mb-8">
            Завантажте CSV-файл, щоб імпортувати дані продажів у систему.
        </p>

        <!-- Повідомлення -->
        @if (ViewBag.Message != null)
        {
            <div class="mb-6 p-4 rounded-lg text-center font-medium
                        @(ViewBag.Message.StartsWith("Успіх") 
                            ? "bg-green-100 text-green-700" 
                            : "bg-red-100 text-red-700")">
                @ViewBag.Message
            </div>
        }

        <!-- ======================== DRAG & DROP ========================= -->
        <form asp-controller="Import" asp-action="Upload" method="post" enctype="multipart/form-data">

            <div id="dropArea"
                 class="border-2 border-dashed border-gray-300 hover:border-blue-500 transition
                        rounded-xl p-6 text-center cursor-pointer bg-gray-50">
                
                <p class="text-gray-600 mb-2">Перетягніть CSV-файл сюди</p>
                <p class="text-gray-400 text-sm mb-4">або натисніть, щоб вибрати</p>

                <input id="fileInput"
                       type="file"
                       name="file"
                       accept=".csv"
                       required
                       class="hidden" />

                <!-- Назва вибраного файлу -->
                <p id="fileName" class="text-blue-600 font-medium hidden"></p>
            </div>

            <button type="submit"
                    class="mt-6 w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg
                           shadow-md transition flex items-center justify-center space-x-2">
                <span>📁</span>
                <span>Завантажити та Імпортувати</span>
            </button>
        </form>

        <!-- Розділювач -->
        <hr class="my-8" />

        <!-- Вимоги -->
        <h6 class="text-lg font-semibold text-gray-700 mb-2">Вимоги до CSV-файлу:</h6>

<p class="text-gray-600 mb-2">
    Файл повинен містити наступні колонки з точними назвами:
</p>

<ul class="list-disc ml-5 text-gray-700 space-y-1">
    <li>
        <span class="text-blue-600 font-semibold">InvoiceDate</span> — дата здійснення транзакції
    </li>
    <li>
        <span class="text-blue-600 font-semibold">CustomerID</span> — ідентифікатор клієнта
    </li>
    <li>
        <span class="text-blue-600 font-semibold">StockCode</span> — код товару
    </li>
    <li>
        <span class="text-blue-600 font-semibold">Quantity</span> — кількість одиниць товару
    </li>
    <li>
        <span class="text-blue-600 font-semibold">UnitPrice</span> — ціна за одиницю товару
    </li>
</ul>


    </div>
</div>
<div id="loadingOverlay"
     style="display:none;"
     class="fixed inset-0 bg-gray-900/70 flex flex-col items-center justify-center z-[9999]">

    <div class="bg-white p-8 rounded-2xl shadow-2xl flex flex-col items-center max-w-sm text-center">
        <div class="w-16 h-16 border-4 border-blue-200 border-t-blue-600 rounded-full animate-spin mb-4"></div>

        <h2 class="text-xl font-bold text-gray-800 mb-2">
            Обробка даних...
        </h2>

        <p class="text-gray-600 text-sm">
            Це може зайняти до 1 хвилини.
        </p>
    </div>
</div>

<style>
    
    @@keyframes loading {
        0% {
            width: 0%;
            margin-left: 0%;
        }

        50% {
            width: 50%;
            margin-left: 25%;
        }

        100% {
            width: 0%;
            margin-left: 100%;
        }
    }
</style>

<!-- ======================== SCRIPT: DRAG & DROP ========================= -->
<script>
    const form = document.querySelector("form");
    const fileInput = document.getElementById("fileInput");
    const dropArea = document.getElementById("dropArea");
    const fileName = document.getElementById("fileName");
    const overlay = document.getElementById("loadingOverlay");
    const submitBtn = form.querySelector('button[type="submit"]');

    // Вибір файлу
    dropArea.addEventListener("click", () => fileInput.click());

    fileInput.addEventListener("change", () => {
        if (fileInput.files.length > 0) {
            fileName.textContent = fileInput.files[0].name;
            fileName.classList.remove("hidden");
        }
    });

    // Drag & Drop
    dropArea.addEventListener("dragover", (e) => {
        e.preventDefault();
        dropArea.classList.add("border-blue-500", "bg-blue-50");
    });

    dropArea.addEventListener("dragleave", () => {
        dropArea.classList.remove("border-blue-500", "bg-blue-50");
    });

    dropArea.addEventListener("drop", (e) => {
        e.preventDefault();

        dropArea.classList.remove("border-blue-500", "bg-blue-50");

        fileInput.files = e.dataTransfer.files;

        if (fileInput.files.length > 0) {
            fileName.textContent = fileInput.files[0].name;
            fileName.classList.remove("hidden");
        }
    });

    // ===== ГОЛОВНЕ =====
    form.addEventListener("submit", function () {

        if (fileInput.files.length === 0)
            return;

        // показуємо модальне вікно
        overlay.style.display = "flex";

        // блокуємо кнопку
        submitBtn.disabled = true;

        submitBtn.innerHTML =
            "<span>⏳</span><span>Обробка...</span>";

        // БІЛЬШЕ НІЧОГО
        // НЕ preventDefault
        // НЕ fetch
    });
</script>