@* SalesAnalysis.Web/Views/Account/Auth.cshtml *@
@model SalesAnalysis.Web.Models.AuthViewModel
@{
    ViewData["Title"] = "Авторизація";
}

<div class="min-h-[80vh] flex items-center justify-center px-4">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">

        <div class="flex border-b">
            <button id="loginTab" onclick="showTab('login')"
                    class="w-1/2 py-4 text-center font-semibold text-blue-600 border-b-2 border-blue-600 transition-all">
                Вхід
            </button>
            <button id="registerTab" onclick="showTab('register')"
                    class="w-1/2 py-4 text-center font-semibold text-gray-500 hover:text-blue-600 transition-all">
                Реєстрація
            </button>
        </div>

        <div class="p-8">
            <div id="loginForm">
                <div class="text-center mb-6">
                    <h2 class="text-2xl font-bold text-gray-900">З поверненням!</h2>
                </div>
                <form asp-action="Login" method="post" class="space-y-4">
                    @* Повідомлення про помилки входу *@
                    <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm italic"></div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700">Email</label>
                        <input asp-for="Login.Email" name="Email" type="email" required class="mt-1 block w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Пароль</label>
                        <input asp-for="Login.Password" name="Password" type="password" required class="mt-1 block w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <button type="submit" class="w-full py-3 px-4 rounded-xl text-white bg-blue-600 hover:bg-blue-700 font-semibold shadow-lg transition-transform hover:scale-[1.02]">
                        Увійти
                    </button>
                </form>
            </div>

            <div id="registerForm" class="hidden">
                <div class="text-center mb-6">
                    <h2 class="text-2xl font-bold text-gray-900">Створити акаунт</h2>
                </div>
                <form asp-action="Register" method="post" class="space-y-4">
                    @* Повідомлення про помилки реєстрації (напр. "Користувач вже існує") *@
                    <div asp-validation-summary="All" class="text-red-500 text-sm italic"></div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700">Ім'я</label>
                        <input asp-for="Register.FirstName" name="FirstName" type="text" required class="mt-1 block w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl focus:ring-blue-500 focus:border-blue-500" placeholder="Введіть ваше ім'я">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Email</label>
                        <input asp-for="Register.Email" name="Email" type="email" required class="mt-1 block w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Пароль</label>
                        <input asp-for="Register.Password" name="Password" type="password" required class="mt-1 block w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-xl focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <button type="submit" class="w-full py-3 px-4 rounded-xl text-white bg-green-600 hover:bg-green-700 font-semibold shadow-lg transition-transform hover:scale-[1.02]">
                        Зареєструватися
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@* Скрипт залишається без змін, він вже коректно перемикає вкладки на основі ViewData["ActiveTab"] *@

<script>
    // Перевіряємо, чи передав контролер інформацію про активну вкладку після помилки
    const activeTabFromServer = '@ViewData["ActiveTab"]';

    if (activeTabFromServer === 'register') {
        showTab('register');
    } else {
        showTab('login');
    }

    function showTab(type) {
        const loginForm = document.getElementById('loginForm');
        const registerForm = document.getElementById('registerForm');
        const loginTab = document.getElementById('loginTab');
        const registerTab = document.getElementById('registerTab');

        if (type === 'login') {
            loginForm.classList.remove('hidden');
            registerForm.classList.add('hidden');

            loginTab.className = "w-1/2 py-4 text-center font-semibold text-blue-600 border-b-2 border-blue-600 transition-all cursor-pointer";
            registerTab.className = "w-1/2 py-4 text-center font-semibold text-gray-400 hover:text-blue-600 transition-all cursor-pointer";
        } else {
            loginForm.classList.add('hidden');
            registerForm.classList.remove('hidden');

            registerTab.className = "w-1/2 py-4 text-center font-semibold text-blue-600 border-b-2 border-blue-600 transition-all cursor-pointer";
            loginTab.className = "w-1/2 py-4 text-center font-semibold text-gray-400 hover:text-blue-600 transition-all cursor-pointer";
        }
    }
</script>